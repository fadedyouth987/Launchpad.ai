# ---------- AI providers (all optional; set any one to turn real AI on) ----------
# Keys stay on the server (on Neon Functions they are uploaded as function env vars by neon.ts, only
# when set here). With no provider configured every AI endpoint returns clearly labelled, free sample
# output. Values starting with "MY_" are treated as unset placeholders.
# Anthropic Claude: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5-5"
# OpenAI: https://platform.openai.com/api-keys  (also image generation)
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-6.1-sol"
# OPENAI_IMAGE_MODEL="gpt-image-2"
# Google Gemini: https://aistudio.google.com/apikey  (GOOGLE_API_KEY also accepted; live web search for trends; images)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL="gemini-3.8-flash"
# GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"
# xAI Grok: https://console.x.ai  (also image generation)
# XAI_API_KEY=""
# XAI_MODEL="grok-4.7"
# XAI_IMAGE_MODEL="grok-imagine-image"
# Neon AI Gateway (one credential for many models; needs a paid Neon plan): Neon console > AI Gateway.
# Base URL is the gateway origin; requests go to <base>/v1/chat/completions.
# NEON_AI_GATEWAY_BASE_URL=""
# NEON_AI_GATEWAY_TOKEN=""
# NEON_AI_GATEWAY_MODEL="claude-sonnet-5-5"
# Neon injects the two gateway variables into Neon Functions automatically; neon.ts keeps the gateway
# off there (AI_GATEWAY_ENABLED=false) because it returns 403 until the account has AI Gateway
# credits (Neon console > Billing > AI Gateway credits) or a paid plan. Set "true" and redeploy then.
# AI_GATEWAY_ENABLED="true"
# Any OpenAI-compatible endpoint (OpenRouter, Groq, DeepSeek, Together, Ollama, LM Studio...).
# Base URL should include the version path, e.g. https://openrouter.ai/api/v1
# OPENAI_COMPATIBLE_BASE_URL=""
# OPENAI_COMPATIBLE_API_KEY=""
# OPENAI_COMPATIBLE_MODEL=""
# OPENAI_COMPATIBLE_LABEL="OpenRouter"
# OPENAI_COMPATIBLE_JSON_MODE="false"   # "true" if the endpoint supports response_format json_object
# Which configured provider is the server default (otherwise the first configured in the order
# gateway, anthropic, openai, gemini, xai, custom) and which one makes images (openai, gemini or xai).
# AI_PROVIDER="anthropic"
# AI_IMAGE_PROVIDER="openai"
# Workspace ("bring your own") keys for anthropic/openai/gemini/xai are stored AES-256-GCM encrypted
# with this 32-byte key and never returned to the browser. Unset = workspace keys disabled.
# Generate with: openssl rand -base64 32   (changing it makes stored workspace keys unreadable)
# AI_KEYS_ENCRYPTION_KEY=""
# Per-request timeout for provider calls (ms).
# AI_REQUEST_TIMEOUT_MS="60000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DEMO_MODE: set to "true" ONLY for local demos. When true, API endpoints skip sign-in,
# and credits use in-memory demo balances for the seeded demo workspaces (reset on restart).
# Leave unset/false in any deployed environment: with NODE_ENV=production the server refuses to start
# in demo mode unless ALLOW_DEMO_MODE_IN_PRODUCTION="true" (public throwaway demo, no GEMINI_API_KEY).
DEMO_MODE="false"

# ---------- Neon (Postgres + Neon Auth + Functions) — required when DEMO_MODE is not "true" ----------
# Production runs the API as the Neon Function "api" (functions/api.ts, declared in neon.ts):
#   npm run deploy:api   (= neon deploy --env .env.local)
# On the function Neon injects DATABASE_URL, DATABASE_URL_UNPOOLED, NEON_AUTH_BASE_URL and
# NEON_AUTH_JWKS_URL; neon.ts sets NODE_ENV=production, SERVE_STATIC=false and ALLOWED_ORIGINS, and
# uploads the optional AI / Stripe / Resend variables only if they are set in .env.local. Do not set TRUST_PROXY there.
# `neon deploy` (or `neon env pull`) writes these to .env.local for the linked branch. Never commit
# real values. In production put DATABASE_URL in Secret Manager (scripts/deploy-cloudrun.sh).
# Pooled connection string (host contains "-pooler"): used by the app at runtime.
DATABASE_URL=""
# Direct (unpooled) connection string: used only by `npm run db:migrate`.
DATABASE_URL_UNPOOLED=""
# Neon Auth endpoint and its JWKS (public URLs, not secrets). The API verifies every
# `Authorization: Bearer <JWT>` against NEON_AUTH_JWKS_URL (EdDSA; iss/aud = the auth origin).
NEON_AUTH_BASE_URL=""
NEON_AUTH_JWKS_URL=""
# Web build only: the Neon Auth URL baked into the browser bundle. Defaults to NEON_AUTH_BASE_URL.
# VITE_NEON_AUTH_URL=""
# "pg" (default, TCP 5432; use on Cloud Run) or "neon-ws" (WebSockets on 443, for networks that
# block 5432). DATABASE_POOL_MAX defaults to 10 connections per instance.
# DATABASE_DRIVER="pg"
# DATABASE_POOL_MAX="10"
# Tests: `npm run test:db` reads ENV_FILE (default .env.test.local) and refuses the production branch.
# ENV_FILE=".env.test.local"

# AI endpoint protection
# Max AI requests per minute per signed-in user (or per IP in demo mode). Default 20.
AI_RATE_LIMIT_PER_MINUTE="20"
# Number of reverse proxies in front of the server (set "1" on Cloud Run / behind a load balancer)
# so rate limiting sees the real client IP. Leave unset when the server is hit directly.
# TRUST_PROXY="1"

# Credits charged per successful AI generation (refunded automatically if the AI call fails).
# AI_GENERATION_COST_CREDITS="15"
# Credits per AI assist (trend scan, reply suggestions, workflow draft); refunded on failure. 0 = free.
# AI_ASSIST_COST_CREDITS="5"
# Credits per generated image (refunded on failure).
# AI_IMAGE_COST_CREDITS="25"
# Credits granted to a newly created workspace (default 0) and max workspaces a user may own.
# NEW_WORKSPACE_CREDITS="0"
# MAX_WORKSPACES_PER_USER="5"
# WEBHOOK_RATE_LIMIT_PER_MINUTE="30"   # per user (per IP in demo) for webhook URL checks

# Webhook delivery: when "true", test sends and asset events (approval.requested, asset.approved,
# asset.scheduled, asset.published, asset.rejected) are POSTed, HMAC-SHA256 signed, connecting only to
# the IP address that passed the SSRF check (DNS-rebinding safe). neon.ts defaults this to "true" on the
# Neon Function. Locally the default is simulated, nothing sent.
WEBHOOK_DELIVERY_ENABLED="false"

# ---------- Payments: Stripe credit top-ups and monthly plans (optional) ----------
# https://dashboard.stripe.com/apikeys  (use sk_test_... for testing). Both are needed to enable payments.
# Webhook endpoint: <API URL>/api/billing/stripe/webhook  with events checkout.session.completed,
# checkout.session.async_payment_succeeded, customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted and invoice.paid; STRIPE_WEBHOOK_SECRET is its signing secret (whsec_...).
# For "Manage billing", save the Customer portal once in Stripe > Settings > Billing > Customer portal.
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_CURRENCY="usd"
# Packs as credits:price_in_cents, comma-separated.
# CREDIT_PACKS="500:1900,1500:4900,5000:14900"
# Monthly plans as plan:price_in_cents:monthly_credits (plans: starter, professional, enterprise).
# PLAN_PRICES="starter:9900:1000,professional:29900:3000,enterprise:89900:10000"
# Members per plan (owner included; 0 = unlimited). Applies to new invitations.
# PLAN_MEMBER_LIMITS="starter:3,professional:10,enterprise:0"
# Public web-app URL for Checkout return links and invite links (default: first ALLOWED_ORIGINS entry).
# PUBLIC_APP_URL="https://launchpad-web.<your-subdomain>.workers.dev"

# ---------- Email: team invitations through Resend (optional) ----------
# https://resend.com/api-keys ; EMAIL_FROM must use a domain verified in Resend.
# Without these, invite links are still created and can be copied from the Team page.
# RESEND_API_KEY=""
# EMAIL_FROM="Launchpad <invites@yourdomain.com>"
# Writes to influencers / Campaign OS / audit events per user per minute.
DATA_WRITE_RATE_LIMIT_PER_MINUTE="120"

# ---------- Split hosting (web app on Cloudflare, API on Cloud Run) ----------
# Server: exact web-app origins allowed to call the API cross-origin (comma-separated, no paths, https
# only except localhost). Empty = same-origin only.
# ALLOWED_ORIGINS="https://launchpad-web.<your-subdomain>.workers.dev,https://app.example.com"
# Server: "false" = API only (do not serve the built web app). Requires ALLOWED_ORIGINS in production.
# SERVE_STATIC="true"
# Web build only (baked into the JS at build time, not a secret): the API origin, e.g. the Cloud Run URL.
# VITE_API_BASE_URL="https://<branch-id>-api.compute.<cell>.ap-southeast-1.aws.neon.tech"   (neon functions get api)

# ---------- Direct social publishing: LinkedIn (optional) ----------
# Create an app at https://www.linkedin.com/developers/apps, add the products "Sign In with LinkedIn using
# OpenID Connect" and "Share on LinkedIn", and register this redirect URL under Auth (API origin, not the web app).
# Tokens are stored encrypted with AI_KEYS_ENCRYPTION_KEY, which must also be set.
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""
# LINKEDIN_REDIRECT_URI="https://<your-api-host>/api/social/linkedin/callback"
# LinkedIn API version (YYYYMM). LinkedIn retires versions after about a year (HTTP 426); bump when that happens.
# LINKEDIN_API_VERSION="202608"
# Scheduler: on Neon Functions the neon.ts trigger calls POST /api/internal/publish-due every minute. A long-running
# server runs it in-process (PUBLISH_SCHEDULER=off to disable). Any other cron can call it with
# "Authorization: Bearer $CRON_SECRET" (at least 16 characters).
# CRON_SECRET=""
# PUBLISH_SCHEDULER="on"

# ---------- AI voice (ElevenLabs) and talking-head video (D-ID) (optional) ----------
# https://elevenlabs.io/app/settings/api-keys  (voice cloning needs a paid ElevenLabs plan)
# ELEVENLABS_API_KEY=""
# ELEVENLABS_MODEL="eleven_multilingual_v2"
# https://studio.d-id.com > API: the key exactly as shown (sent as "Authorization: Basic <key>").
# DID_API_KEY=""
# D-ID downloads the avatar photo and audio from this API through signed one-hour links, so the API must be
# reachable from the internet. Set its public https origin (on Neon Functions the request host is used if unset).
# PUBLIC_API_URL="https://<your-api-host>"
# Secret for those signed links (default: AI_KEYS_ENCRYPTION_KEY).
# MEDIA_URL_SECRET=""
# Credits per speech clip / per talking video (the video price includes its speech).
# AI_VOICE_COST_CREDITS="5"
# AI_VIDEO_COST_CREDITS="60"
# Cloned voices per workspace (all workspaces share the ElevenLabs account's voice slots).
# AI_VOICE_CLONE_LIMIT="5"
